# Streamlit Community Cloud → 앱 → Settings → Secrets 에 아래 내용을 붙여 넣고 값을 바꾸세요.
# (이 파일 자체는 예시입니다. 진짜 값을 이 파일에 적어 GitHub 에 올리지 마세요.)

# 폰 알림 주제 이름 — GitHub Secrets 의 NTFY_TOPIC 과 똑같이
NTFY_TOPIC = "shortradar-여기에-긴-무작위-문자"
# NTFY_SERVER = "https://ntfy.sh"

# 대시보드 비밀번호 (선택 — 넣으면 주소를 아는 사람도 비밀번호 없이는 못 봄)
APP_PASSWORD = "원하는-비밀번호"

# GitHub 에서 최신 데이터·알림 기록 읽기 (클라우드 모드)
GH_REPO = "ogeunho011-dotcom/short-dashboard"
GH_TOKEN = "github_pat_여기에-토큰"
# GH_ALERT_BRANCH = "alert-data"

# 텔레그램도 쓰려면 (선택)
# TELEGRAM_BOT_TOKEN = "123456:ABC..."
# TELEGRAM_CHAT_ID = "123456789"

# 알림의 '대시보드' 버튼 주소 (선택)
# DASH_URL = "https://ogeunho011-short-dashboard.streamlit.app"
